# Application
APP_NAME=team-ops-mcp
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Allowed Host / Origin headers for MCP DNS-rebinding protection (JSON arrays)
ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]

# GitHub REST API (free Personal Access Token; fine-grained or classic with public_repo/repo issues)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=15.0